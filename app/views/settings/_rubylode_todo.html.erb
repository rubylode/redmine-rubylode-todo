<%# Defaults for a line added on the To-do page. Redmine wraps this in the plugin's settings form. %>
<%
  people = User.active.sorted.to_a
  people += Group.givable.sorted.to_a if Setting.issue_group_assignment?
  assignee_choices = [[l("rubylode_todo.settings.options.nobody"), ""], [l("rubylode_todo.settings.options.author"), "author"]] +
                     people.map { |person| [person.name, person.id.to_s] }
%>
<p><%= l("rubylode_todo.settings.intro") %></p>

<div class="tabular settings">
  <p>
    <label for="settings_assignee"><%= l("rubylode_todo.settings.assignee.label") %></label>
    <%= select_tag "settings[assignee]", options_for_select(assignee_choices, settings["assignee"].to_s), id: "settings_assignee" %>
    <em class="info"><%= l("rubylode_todo.settings.assignee.hint") %></em>
  </p>
  <p>
    <label for="settings_tracker_id"><%= l("rubylode_todo.settings.tracker_id.label") %></label>
    <%= select_tag "settings[tracker_id]",
                   options_for_select([[l("rubylode_todo.settings.options.default_tracker"), ""]] + Tracker.sorted.map { |tracker| [tracker.name, tracker.id.to_s] }, settings["tracker_id"].to_s),
                   id: "settings_tracker_id" %>
    <em class="info"><%= l("rubylode_todo.settings.tracker_id.hint") %></em>
  </p>
  <p>
    <label for="settings_status_id"><%= l("rubylode_todo.settings.status_id.label") %></label>
    <%= select_tag "settings[status_id]",
                   options_for_select([[l("rubylode_todo.settings.options.default_status"), ""]] + IssueStatus.sorted.map { |status| [status.name, status.id.to_s] }, settings["status_id"].to_s),
                   id: "settings_status_id" %>
    <em class="info"><%= l("rubylode_todo.settings.status_id.hint") %></em>
  </p>
  <p>
    <label for="settings_priority_id"><%= l("rubylode_todo.settings.priority_id.label") %></label>
    <%= select_tag "settings[priority_id]",
                   options_for_select([[l("rubylode_todo.settings.options.default_priority"), ""]] + IssuePriority.active.sorted.map { |priority| [priority.name, priority.id.to_s] }, settings["priority_id"].to_s),
                   id: "settings_priority_id" %>
    <em class="info"><%= l("rubylode_todo.settings.priority_id.hint") %></em>
  </p>
  <p>
    <label for="settings_version_name"><%= l("rubylode_todo.settings.version_name.label") %></label>
    <%= text_field_tag "settings[version_name]", settings["version_name"], id: "settings_version_name", size: 30 %>
    <em class="info"><%= l("rubylode_todo.settings.version_name.hint") %></em>
  </p>
  <p>
    <label for="settings_category_name"><%= l("rubylode_todo.settings.category_name.label") %></label>
    <%= text_field_tag "settings[category_name]", settings["category_name"], id: "settings_category_name", size: 30 %>
    <em class="info"><%= l("rubylode_todo.settings.category_name.hint") %></em>
  </p>
  <p>
    <label for="settings_start_date"><%= l("rubylode_todo.settings.start_date.label") %></label>
    <%= select_tag "settings[start_date]",
                   options_for_select([[l("rubylode_todo.settings.options.no_date"), ""], [l("rubylode_todo.settings.options.today"), "today"]], settings["start_date"].to_s),
                   id: "settings_start_date" %>
    <em class="info"><%= l("rubylode_todo.settings.start_date.hint") %></em>
  </p>
  <p>
    <label for="settings_due_in_days"><%= l("rubylode_todo.settings.due_in_days.label") %></label>
    <%= number_field_tag "settings[due_in_days]", settings["due_in_days"], id: "settings_due_in_days", min: 0, size: 4 %>
    <em class="info"><%= l("rubylode_todo.settings.due_in_days.hint") %></em>
  </p>
</div>
