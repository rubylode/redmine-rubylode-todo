<% html_title l(:label_todo) %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag "todo", plugin: "redmine_todo" %>
  <%= javascript_include_tag "todo", plugin: "redmine_todo", type: "module" %>
<% end %>
<%= context_menu %>
<%# What the ticket form in the modal needs: the editor toolbar for its text areas, and the date fields. %>
<% heads_for_wiki_formatter %>
<% include_calendar_headers_tags %>

<h2><%= l(:label_todo) %></h2>

<%= tag.div class: "todo",
            data: { controller: "todo",
                    todo_lines_path_value: project_todo_lines_path(@project),
                    todo_page_url_value: project_todo_path(@project, todo_query_params(@query)),
                    todo_confirm_close_subtree_value: l(:text_todo_confirm_close_subtree, count: "%{count}"),
                    todo_confirm_reopen_subtree_value: l(:text_todo_confirm_reopen_subtree, count: "%{count}"),
                    todo_composer_placeholder_value: l(:text_todo_composer_hint),
                    todo_too_many_lines_value: l(:text_todo_too_many_lines, count: "%{count}"),
                    todo_edit_keys_value: l(:text_todo_edit_keys),
                    todo_composer_keys_value: l(:text_todo_composer_keys, nest: "%{nest}"),
                    todo_nest_under_value: l(:label_todo_nest_under, id: "%{id}"),
                    todo_announcements_value: { closed: l(:text_todo_announce_closed, id: "%{id}"),
                                                reopened: l(:text_todo_announce_reopened, id: "%{id}"),
                                                moved: l(:text_todo_announce_moved, id: "%{id}"),
                                                created: l(:text_todo_announce_created, id: "%{id}"),
                                                saved: l(:text_todo_announce_saved, id: "%{id}") },
                    todo_loading_value: l(:text_todo_loading),
                    todo_failure_value: l(:text_todo_request_failed) } do %>
  <div class="contextual">
    <a href="#" data-action="click->todo#showShortcuts"><%= l(:label_todo_shortcuts) %> ?</a> |
    <a href="#" role="button" aria-pressed="false" title="<%= l(:text_todo_full_text_hint) %>"
       data-todo-full-label="<%= l(:label_todo_full_text) %>" data-todo-cut-label="<%= l(:label_todo_cut_text) %>"
       data-action="click->todo#toggleFullText"><%= l(:label_todo_full_text) %></a> |
    <a href="#" data-action="click->todo#collapseAll"><%= l(:label_todo_collapse_all) %></a> |
    <a href="#" data-action="click->todo#expandAll"><%= l(:label_todo_expand_all) %></a> |
    <% if @show_closed %>
      <%= link_to l(:label_todo_hide_closed), project_todo_path(@project, todo_status_params(@query, false)) %>
    <% else %>
      <%= link_to l(:label_todo_show_closed), project_todo_path(@project, todo_status_params(@query, true)) %>
    <% end %>
  </div>

  <%= render "todo/filters" %>

  <p class="todo-message flash error" role="alert" hidden data-todo-target="message"></p>
  <div class="todo-live" role="status" aria-live="polite" data-todo-target="live"></div>

  <%= form_tag({}, data: { cm_url: issues_context_menu_path }, onsubmit: "return false;") do %>
    <div data-todo-target="list">
      <%= render "todo/list", todo_tree: @todo_tree %>
    </div>
  <% end %>

  <input type="text" class="todo-new-line" autocomplete="off"
         placeholder="<%= l(:label_todo_new_line) %>"
         data-todo-target="newLine" data-action="keydown->todo#addLine paste->todo#pasteIntoNewLine">

  <dialog class="todo-shortcuts" data-todo-target="shortcuts" aria-labelledby="todo-shortcuts-title">
    <h3 id="todo-shortcuts-title"><%= l(:label_todo_shortcuts) %></h3>
    <dl>
      <% [["Enter", :text_todo_key_enter], ["Tab / Shift+Tab", :text_todo_key_tab], ["Esc", :text_todo_key_escape],
          ["Up / Down", :text_todo_key_up_down], ["Alt+Up / Alt+Down", :text_todo_key_alt_up_down],
          ["Alt+Right / Alt+Left", :text_todo_key_alt_left_right], ["Cmd+Enter / Ctrl+Enter", :text_todo_key_cmd_enter],
          ["Paste", :text_todo_key_paste], ["?", :text_todo_key_question]].each do |keys, description| %>
        <dt><kbd><%= keys %></kbd></dt>
        <dd><%= l(description) %></dd>
      <% end %>
    </dl>
    <form method="dialog"><button class="todo-shortcuts-close"><%= l(:button_close) %></button></form>
  </dialog>

  <%# The ticket's own page, shown here: its card, and its edit form behind the Edit button. %>
  <dialog class="todo-ticket-dialog" data-todo-target="ticketDialog" aria-label="<%= l(:label_todo_ticket) %>"
          data-action="click->todo#closeTicketOnBackdrop close->todo#clearTicket submit->todo#submitTicket">
    <button type="button" class="todo-ticket-close" aria-label="<%= l(:button_close) %>" data-action="click->todo#closeTicket">&times;</button>
    <div class="todo-ticket-body" data-todo-target="ticketBody"></div>
  </dialog>
<% end %>
