<% html_title l(:label_todo) %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag "todo", plugin: "redmine_todo" %>
  <%= javascript_include_tag "todo", plugin: "redmine_todo", type: "module" %>
<% end %>
<%= context_menu %>

<h2><%= l(:label_todo) %></h2>

<%= tag.div class: "todo",
            data: { controller: "todo",
                    todo_lines_path_value: project_todo_lines_path(@project),
                    todo_page_url_value: project_todo_path(@project, show_closed: (1 if @show_closed)),
                    todo_confirm_close_subtree_value: l(:text_todo_confirm_close_subtree, count: "%{count}"),
                    todo_confirm_reopen_subtree_value: l(:text_todo_confirm_reopen_subtree, count: "%{count}"),
                    todo_failure_value: l(:text_todo_request_failed) } do %>
  <div class="contextual">
    <a href="#" data-action="click->todo#collapseAll"><%= l(:label_todo_collapse_all) %></a> |
    <a href="#" data-action="click->todo#expandAll"><%= l(:label_todo_expand_all) %></a> |
    <% if @show_closed %>
      <%= link_to l(:label_todo_hide_closed), project_todo_path(@project) %>
    <% else %>
      <%= link_to l(:label_todo_show_closed), project_todo_path(@project, show_closed: 1) %>
    <% end %>
  </div>

  <p class="todo-message flash error" role="alert" hidden data-todo-target="message"></p>

  <%= form_tag({}, data: { cm_url: issues_context_menu_path }, onsubmit: "return false;") do %>
    <div data-todo-target="list">
      <%= render "todo/list", todo_tree: @todo_tree %>
    </div>
  <% end %>

  <input type="text" class="todo-new-line" autocomplete="off"
         placeholder="<%= l(:label_todo_new_line) %>"
         data-todo-target="newLine" data-action="keydown->todo#addLine">
<% end %>
